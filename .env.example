# Docker Compose 环境变量示例
# 复制此文件为 .env 并修改相应的值

# 管理端登录账号；必须设置非空密码，没有默认密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 容器内配置文件路径（宿主机的 ./config.json 将挂载到此路径）
CONFIG_PATH=/home/config.json

# 广播地址在 Web 管理页面的“网络设置”中配置，保存后立即生效。

# 时区
TZ=Asia/Shanghai

# 仅手动切换到 bridge 并配置 ${PORT:-1323}:1323 映射时使用。
# 默认 host 模式固定使用宿主机 1323 端口，此变量不生效。
PORT=1323
